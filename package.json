{
  "name": "roi-calculator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "homepage": "https://sam-mfb.github.io/roi",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "deploy": "gh-pages -d dist",
    "webflow:build": "webflow library bundle --public-path ./",
    "webflow:share": "webflow library share",
    "webflow:share:ci": "webflow library share --no-input"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.10.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-redux": "^9.2.0"
  },
  "overrides": {
    "koa": "^3.1.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@webflow/data-types": "^1.1.0",
    "@webflow/react": "^1.1.0",
    "@webflow/webflow-cli": "^1.10.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.0.16"
  }
